{

  "version": 2,

  "headers": [

    {

      "source": "/app.js",

      "headers": [

        {

          "key": "Cache-Control",

          "value": "no-cache, must-revalidate"

        }

      ]

    },

    {

      "source": "/api/(.*)",

      "headers": [

        {

          "key": "Cache-Control",

          "value": "no-store, max-age=0"

        }

      ]

    }

  ]

}